# Environment variables already defined in your shell/system are loaded automatically.
# Copy this file to .env only when you want project-local development values.
MISTRAL_API_KEY="your-mistral-api-key"
FLASK_SECRET_KEY="replace-with-a-long-random-string"

# OCR scheduler. The current account limit is 1250 pages/minute; DocsLaju
# targets 88% so manual current-page work and short bursts retain headroom.
MISTRAL_OCR_PAGES_PER_MINUTE=1250
OCR_TARGET_UTILIZATION=0.88
OCR_INITIAL_CONCURRENCY=4
OCR_MAX_CONCURRENCY=24
OCR_MAX_ATTEMPTS=3
OCR_BATCH_ENABLED=true
OCR_BATCH_MIN_PAGES=500
# A forced Batch calibration showed that 32-page jobs amortize provider queue
# overhead much better than tiny batches. Adaptive mode still requires saved
# Batch telemetry before it will select this path automatically.
OCR_BATCH_SIZE=32

# Optional SQLite location. Defaults to instance/docslaju.sqlite3.
# DOCSLAJU_DB_PATH="instance/docslaju.sqlite3"
# DOCSLAJU_VALIDATE_UPLOADS=true

# Optional overrides for rendered PDF export. Chrome or Edge is detected automatically.
# DOCSLAJU_BROWSER_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# DOCSLAJU_INTERNAL_BASE_URL="http://127.0.0.1:5000"

# Optional; reserved for future AI-generated filename support.
OPENAI_API_KEY=""
